{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrumlatro",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  // Static SPA assets (built by Vite into dist/client). Unmatched paths fall
  // back to index.html so client-side routes like /room/ABCD work on reload.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // One Durable Object instance per room holds all room state + WebSockets.
  // SQLite-backed classes are eligible for the Workers free plan.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
